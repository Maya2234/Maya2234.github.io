---
// Tools pulled from Maya's public GitHub repos (languages + package.json dependencies), Nov 2026.
// `used` records which repos each tool came from, for reference when updating this list.
import { getLang, t } from '../i18n';

const w = t(getLang(Astro.url));

const groups = [
	{
		label: w('stack.programming'),
		items: [
			{ name: 'JavaScript', used: 'Cube World Aero, myPoleMagazine, language-today' },
			{ name: 'TypeScript', used: 'SlapBox, this portfolio' },
			{ name: 'Python', used: 'language-today' },
			{ name: 'Java', used: 'MayasLibrary' },
			{ name: 'HTML', used: 'Anuva Cleaning, My Fruit Worth' },
			{ name: 'CSS', used: 'every site here' },
			{ name: 'SQL', used: 'myPoleMagazine (PL/pgSQL)' },
		],
	},
	{
		label: w('stack.frameworks'),
		items: [
			{ name: 'React', used: 'SlapBox, this portfolio' },
			{ name: 'React Native', used: 'SlapBox' },
			{ name: 'Expo', used: 'SlapBox' },
			{ name: 'Svelte', used: 'smartFridge' },
			{ name: 'Astro', used: 'this portfolio' },
			{ name: 'Framer Motion', used: 'this portfolio' },
			{ name: 'WebGL', used: 'Cube World Aero' },
		],
	},
	{
		label: w('stack.tooling'),
		items: [
			{ name: 'Supabase', used: 'myPoleMagazine, SlapBox' },
			{ name: 'PostgreSQL', used: 'myPoleMagazine' },
			{ name: 'Vite', used: 'smartFridge, this portfolio' },
			{ name: 'GitHub Actions', used: 'myPoleMagazine, language-today' },
			{ name: 'Git', used: 'all 11 repos' },
		],
	},
	{
		// the languages Maya speaks, named in the page's language, with CEFR levels
		label: w('langs.title'),
		items: [
			{ name: w('langs.english'), used: '' },
			{ name: `${w('langs.spanish')} (B2)`, used: '' },
			{ name: `${w('langs.italian')} (A2)`, used: '' },
		],
	},
];
---

<section class="stack" aria-label={w('stack.aria')}>
	<div class="stack-body">
		{groups.map((group) => (
			<div class="group">
				<h2 class="group-label">{group.label}</h2>
				<ul class="bubbles">
					{group.items.map((item) => (
						<li class="bubble">
							<span class="orb" aria-hidden="true"></span>
							{item.name}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</section>

<style>
	.stack {
		width: 100%;
	}

	.stack-body {
		display: grid;
		gap: 1.75rem;
	}

	.group {
		display: grid;
		grid-template-columns: 13rem 1fr;
		align-items: start;
		gap: 0.75rem 2rem;
	}

	.group-label {
		margin: 0.55rem 0 0;
		font-family: var(--font-tech);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.bubbles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* aqua gel bubble from the 2000s icon sheet */
	.bubble {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem 0.5rem 0.6rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: linear-gradient(180deg, #ffffff 0%, #eaf9ff 46%, #c4efff 52%, #e9fbff 100%);
		font-size: 0.975rem;
		font-weight: 600;
	}

	.orb {
		width: 0.9rem;
		height: 0.9rem;
		border: 1.5px solid var(--ink);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #ffffff 0 18%, #ff8ac0 45%, #d62c76 100%);
	}

	.group:nth-child(2) .orb {
		background: radial-gradient(circle at 35% 30%, #ffffff 0 18%, var(--cyan) 45%, #00a7c4 100%);
	}

	.group:nth-child(3) .orb {
		background: radial-gradient(circle at 35% 30%, #ffffff 0 18%, #ffe56b 45%, #d1a600 100%);
	}

	/* sits under the bubbles, lined up with them */
	.gh-link {
		display: grid;
		place-items: center;
		justify-self: start;
		width: 2.75rem;
		height: 2.75rem;
		margin-left: 15rem;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
		color: var(--ink);
	}

	.gh-link svg {
		width: 1.3rem;
		height: 1.3rem;
		fill: currentColor;
	}

	.gh-link:focus-visible {
		outline: 3px solid var(--white);
		outline-offset: 3px;
	}

	@media (max-width: 760px) {
		.group {
			grid-template-columns: 1fr;
		}

		.group-label {
			margin-top: 0;
		}

		.gh-link {
			margin-left: 0;
		}
	}
</style>
