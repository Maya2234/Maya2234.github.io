---
// Tools pulled from Maya's public GitHub repos (languages + package.json dependencies), Nov 2026.
// Each entry names a repo it shows up in, shown on hover/focus.
const groups = [
	{
		label: 'Languages',
		items: [
			{ name: 'JavaScript', used: 'Cube World Aero, myPoleMagazine, language-today' },
			{ name: 'TypeScript', used: 'SlapBox, this portfolio' },
			{ name: 'Python', used: 'language-today' },
			{ name: 'Java', used: 'MayasLibrary' },
			{ name: 'HTML', used: 'Anuva Cleaning, My Fruit Worth' },
			{ name: 'CSS', used: 'every site here' },
			{ name: 'SQL', used: 'myPoleMagazine (PL/pgSQL)' },
		],
	},
	{
		label: 'Frameworks & libraries',
		items: [
			{ name: 'React', used: 'SlapBox, this portfolio' },
			{ name: 'React Native', used: 'SlapBox' },
			{ name: 'Expo', used: 'SlapBox' },
			{ name: 'Svelte', used: 'smartFridge' },
			{ name: 'Astro', used: 'this portfolio' },
			{ name: 'Framer Motion', used: 'this portfolio' },
			{ name: 'WebGL', used: 'Cube World Aero' },
		],
	},
	{
		label: 'Data & tooling',
		items: [
			{ name: 'Supabase', used: 'myPoleMagazine, SlapBox' },
			{ name: 'PostgreSQL', used: 'myPoleMagazine' },
			{ name: 'Vite', used: 'smartFridge, this portfolio' },
			{ name: 'GitHub Actions', used: 'myPoleMagazine, language-today' },
			{ name: 'Git', used: 'all 11 repos' },
		],
	},
];
---

<section class="stack" aria-label="Tech stack">
	<div class="stack-body">
		{groups.map((group) => (
			<div class="group">
				<h2 class="group-label">{group.label}</h2>
				<ul class="bubbles">
					{group.items.map((item) => (
						<li class="bubble" tabindex="0" aria-describedby={`used-${item.name.replace(/\W+/g, '')}`}>
							<span class="orb" aria-hidden="true"></span>
							{item.name}
							<span class="used" role="tooltip" id={`used-${item.name.replace(/\W+/g, '')}`}>Used in {item.used}</span>
						</li>
					))}
				</ul>
			</div>
		))}
		<a class="gh-link" href="https://github.com/maya2234" target="_blank" rel="noreferrer" aria-label="See the code on GitHub">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3" /></svg>
		</a>
	</div>
</section>

<style>
	.stack {
		width: 100%;
	}

	.stack-body {
		display: grid;
		gap: 1.75rem;
	}

	.group {
		display: grid;
		grid-template-columns: 13rem 1fr;
		align-items: start;
		gap: 0.75rem 2rem;
	}

	.group-label {
		margin: 0.55rem 0 0;
		font-family: var(--font-tech);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.bubbles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* aqua gel bubble from the 2000s icon sheet */
	.bubble {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem 0.5rem 0.6rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: linear-gradient(180deg, #ffffff 0%, #eaf9ff 46%, #c4efff 52%, #e9fbff 100%);
		font-size: 0.975rem;
		font-weight: 600;
		transition: transform 0.2s var(--ease-out);
	}

	.orb {
		width: 0.9rem;
		height: 0.9rem;
		border: 1.5px solid var(--ink);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #ffffff 0 18%, #ff8ac0 45%, #d62c76 100%);
	}

	.group:nth-child(2) .orb {
		background: radial-gradient(circle at 35% 30%, #ffffff 0 18%, var(--cyan) 45%, #00a7c4 100%);
	}

	.group:nth-child(3) .orb {
		background: radial-gradient(circle at 35% 30%, #ffffff 0 18%, #ffe56b 45%, #d1a600 100%);
	}

	.bubble:hover,
	.bubble:focus-visible {
		transform: translateY(-3px);
		outline: none;
	}

	.bubble:focus-visible {
		box-shadow: 0 0 0 3px var(--cyan);
	}

	.used {
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		z-index: 3;
		width: max-content;
		max-width: 16rem;
		padding: 0.4rem 0.65rem;
		border: 2px solid var(--ink);
		border-radius: 8px;
		background: var(--ink);
		color: var(--white);
		font-size: 0.8125rem;
		font-weight: 400;
		line-height: 1.35;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 4px);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.bubble:hover .used,
	.bubble:focus-visible .used {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	/* sits under the bubbles, lined up with them */
	.gh-link {
		display: grid;
		place-items: center;
		justify-self: start;
		width: 2.75rem;
		height: 2.75rem;
		margin-left: 15rem;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
		color: var(--ink);
		transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s var(--ease-out);
	}

	.gh-link svg {
		width: 1.3rem;
		height: 1.3rem;
		fill: currentColor;
	}

	.gh-link:hover {
		background: var(--ink);
		color: var(--white);
		transform: translateY(-2px);
	}

	.gh-link:focus-visible {
		outline: 3px solid var(--white);
		outline-offset: 3px;
	}

	@media (max-width: 760px) {
		.group {
			grid-template-columns: 1fr;
		}

		.group-label {
			margin-top: 0;
		}

		.gh-link {
			margin-left: 0;
		}
	}
</style>
