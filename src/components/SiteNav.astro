---
import Sparkle from './Sparkle.astro';
import { getLang, languages, localize, switchLang, t, type Lang } from '../i18n';

interface Props {
	current?: 'home' | 'projects' | 'wall';
}

const { current } = Astro.props;
const lang = getLang(Astro.url);
const w = t(lang);
---

<!-- no menu: the wordmark goes home, and EN | IT switches language (same page, other language) -->
<nav class="site-nav" aria-label="Main">
	{current !== 'home' && (
		<a class="wordmark" href={localize(lang)} aria-label={w('nav.home')}>
			<Sparkle size={26} />
			<span>MT</span>
		</a>
	)}
	<ul class="langs" aria-label={w('nav.language')}>
		{(Object.keys(languages) as Lang[]).map((code) => (
			<li>
				<a href={switchLang(Astro.url, code)} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>
					{languages[code]}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.site-nav {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1240px;
		margin: 0 auto;
		padding: 1.25rem 4vw 0;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--white);
		font-family: var(--font-display);
		font-size: 1.15rem;
		text-decoration: none;
	}

	/* EN | IT: small tech-font labels, the current one white and underlined */
	.langs {
		display: flex;
		align-items: center;
		/* stays on the right even when there is no wordmark (the homepage has its own fixed home button) */
		margin: 0 0 0 auto;
		padding: 0;
		list-style: none;
		font-family: var(--font-tech);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.langs li + li::before {
		content: '|';
		margin: 0 0.6rem;
		color: var(--ink);
		opacity: 0.5;
	}

	.langs a {
		padding: 0.25rem 0;
		color: var(--ink);
		text-decoration: none;
	}

	.langs a[aria-current] {
		color: var(--white);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}

	.langs a:hover {
		color: var(--white);
	}

	.langs a:focus-visible,
	.wordmark:focus-visible {
		outline: 3px solid var(--white);
		outline-offset: 4px;
	}

	@media (max-width: 520px) {
		.site-nav {
			padding: 1rem 16px 0;
		}

		.wordmark {
			font-size: 1rem;
		}
	}
</style>
