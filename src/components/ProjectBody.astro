---
import Sparkle from './Sparkle.astro';
import { getLang, localize, t } from '../i18n';

interface Props {
	title: string;
	subtitle: string;
	image: string;
	alt: string;
	url: string;
	cta: string;
	tags?: string[];
}

const { title, subtitle, image, alt, url, cta, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url);
const w = t(lang);
const file = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<!-- one project's page: used on its own route and, on the homepage canvas, below the top row -->
<article class="project-page" data-project={file}>
	<a class="btn-gloss back-link" href={`${localize(lang)}#projects`}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
		<span>{w('project.back')}</span>
	</a>

	<header class="hero">
		<h1>{title}<span class="spark-anchor"><Sparkle size={40} class="title-spark" /></span></h1>
		<p class="subtitle">{subtitle}</p>
		{tags.length > 0 && (
			<ul class="tags" aria-label={w('project.builtWith')}>
				{tags.map((tag) => <li>{tag}</li>)}
			</ul>
		)}
	</header>

	<div class="top">
		<a href={url} target="_blank" rel="noreferrer" class="window preview">
			<span class="window-bar">
				<span></span>
				<span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
			</span>
			<img src={`${base}${image}`} alt={alt} />
			<span class="visually-hidden">{w('project.open')} {title} {w('project.newTab')}</span>
		</a>

		<section class="window about" aria-label={`${w('project.about')} ${title}`}>
			<div class="window-bar">
				<span></span>
				<span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
			</div>
			<div class="window-body">
				<slot />
				<a href={url} target="_blank" rel="noreferrer" class="btn-gloss">{cta} <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	</div>

	{Astro.slots.has('details') && (
		<section class="window details" aria-label={w('project.details')}>
			<div class="window-bar">
				<span></span>
				<span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
			</div>
			<div class="window-body details-body">
				<slot name="details" />
			</div>
		</section>
	)}
</article>

<style>
	.project-page {
		max-width: 1240px;
		margin: 0 auto;
		padding: 2.5rem 8vw 0;
	}

	/* same glossy blue pill as the other buttons (btn-gloss in brand.css) */
	.back-link {
		margin-bottom: 2.5rem;
		padding: 0.7rem 1.5rem 0.7rem 1.2rem;
	}

	.back-link svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hero {
		margin-bottom: 3rem;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5.5vw, 4.25rem);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: var(--white);
	}

	.spark-anchor {
		position: relative;
		display: inline-block;
		width: 0;
		height: 0;
	}

	.spark-anchor :global(.title-spark) {
		position: absolute;
		bottom: 0.45em;
		left: 2px;
	}

	.subtitle {
		margin: 1rem 0 0;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.2rem 0.6rem;
		border: 1.5px solid var(--ink);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.top {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: start;
	}

	.preview {
		color: inherit;
		text-decoration: none;
		transition: transform 0.3s var(--ease-out);
	}

	.preview img {
		display: block;
		width: 100%;
		height: auto;
	}

	.preview:hover {
		transform: translateY(-4px) rotate(-0.4deg);
	}

	.window-body {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem 1.6rem 1.75rem;
		background: var(--pink-soft);
	}

	.about .btn-gloss {
		justify-self: start;
	}

	.window-body :global(p),
	.window-body :global(li) {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.details {
		margin-top: 3rem;
	}

	.details-body {
		gap: 2rem;
		padding: 2rem clamp(1.5rem, 3vw, 2.75rem) 2.25rem;
	}

	.details-body :global(h2) {
		margin: 0 0 0.6rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 900;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.details-body :global(h3) {
		margin: 1rem 0 0.4rem;
		font-family: var(--font-tech);
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.details-body :global(ul),
	.details-body :global(ol) {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding-left: 1.3rem;
		max-width: 75ch;
	}

	.details-body :global(p) {
		max-width: 75ch;
	}

	.details-body :global(p + p) {
		margin-top: 0.6rem;
	}

	.details-body :global(code) {
		padding: 0.05rem 0.35rem;
		border: 1.5px solid var(--ink);
		border-radius: 4px;
		background: var(--white);
		font-size: 0.95em;
	}

	.back-link:focus-visible,
	.preview:focus-visible {
		outline: 3px solid var(--white);
		outline-offset: 3px;
	}

	@media (max-width: 860px) {
		.top {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.project-page {
			padding: 2rem 20px 0;
		}
	}
</style>
