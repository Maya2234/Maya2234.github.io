---
import Sparkle from './Sparkle.astro';
import { getLang, localize, t } from '../i18n';

interface Props {
	showWallLink?: boolean;
}

const { showWallLink = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url);
const w = t(lang);

---

<footer class="site-foot">
	<div class="window foot-window">
		<div class="window-bar">
			<span></span>
			<span class="lights" aria-hidden="true"><span></span></span>
		</div>
		<div class="foot-body">
			<Sparkle size={30} class="foot-spark" delay={0.8} />
			<div class="foot-main">
				<p class="foot-line">{w('footer.line')} <span class="arrow-from">{w('footer.vision')}</span></p>

				<div class="foot-row">
					<ul class="contact">
						<li><a href="mailto:mayato223@gmail.com">mayato223@gmail.com</a></li>
						<li><a href="tel:+12162134834" class="arrow-to">+1 216-213-4834</a></li>
					</ul>

					<div class="foot-actions">
						<a href={`${base}resume.pdf`} class="btn-gloss resume" download="Maya-Tomarchio-Resume.pdf">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 20h16" /></svg>
							{w('footer.resume')}
						</a>
						{showWallLink && <a href={localize(lang, 'message-wall')} class="btn-gloss">{w('footer.wall')}</a>}
						<div class="socials">
							<!-- the quarterly newsletter sign-up lives under the guest book on the homepage -->
							<a href={`${localize(lang)}#newsletter`} aria-label={w('news.title')} title={w('news.title')}>
								<svg viewBox="0 0 24 24" aria-hidden="true" class="news-icon"><path d="M4 5h13v13a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2z" /><path d="M17 9h3v9a2 2 0 0 1-2 2" /><path d="M7 9h7M7 12.5h7M7 16h4" /></svg>
							</a>
							<a href="https://github.com/maya2234" target="_blank" rel="noreferrer" aria-label="GitHub">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3" /></svg>
							</a>
							<a href="https://www.linkedin.com/in/MayaTomarchio" target="_blank" rel="noreferrer" aria-label="LinkedIn">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
							</a>
						</div>
					</div>
				</div>

				<svg class="foot-arrow" aria-hidden="true"><path class="arrow-line" /><path class="arrow-head" /></svg>
			</div>
		</div>
	</div>
	<p class="copyright">© {new Date().getFullYear()} Maya Tomarchio</p>
</footer>

<script>
	// Hand-drawn curved arrow from the word "vision" to the phone number, measured live so it fits any layout
	const main = document.querySelector<HTMLElement>('.foot-main');
	const from = main?.querySelector<HTMLElement>('.arrow-from');
	const to = main?.querySelector<HTMLElement>('.arrow-to');
	const svg = main?.querySelector<SVGSVGElement>('.foot-arrow');

	if (main && from && to && svg) {
		const line = svg.querySelector<SVGPathElement>('.arrow-line')!;
		const head = svg.querySelector<SVGPathElement>('.arrow-head')!;

		// measured on screen, then divided by the zoom so it's right even when the homepage canvas is zoomed
		const local = (r: DOMRect, s: number) => ({ left: r.left / s, right: r.right / s, top: r.top / s, bottom: r.bottom / s, width: r.width / s, height: r.height / s });
		const draw = () => {
			const zoom = main.getBoundingClientRect().width / main.offsetWidth || 1;
			const box = local(main.getBoundingClientRect(), zoom);
			const a = local(from.getBoundingClientRect(), zoom);
			const b = local(to.getBoundingClientRect(), zoom);
			svg.setAttribute('width', String(box.width));
			svg.setAttribute('height', String(box.height));

			// leave from just under "vision" and land on the phone number. Normally it lands on top of the number;
			// when the email stacks above it (phones), it swings out right of the links and comes in from the side instead
			const sx = a.left - box.left + a.width * 0.8;
			const sy = a.bottom - box.top + 4;
			const links = [...main.querySelectorAll<HTMLElement>('.contact a')].map((l) => local(l.getBoundingClientRect(), zoom));
			const stacked = links.some((l) => l.bottom <= b.top + 1);
			let ex: number, ey: number, c1x: number, c1y: number, c2x: number, c2y: number;
			if (stacked) {
				const rightmost = Math.max(...links.map((l) => l.right)) - box.left;
				ex = b.right - box.left + 10;
				ey = b.top - box.top + b.height * 0.5;
				c1x = Math.max(sx + 40, rightmost + 36);
				c1y = sy + 18;
				c2x = Math.max(ex + 44, rightmost + 44);
				c2y = ey;
			} else {
				ex = b.left - box.left + b.width * 0.5;
				ey = b.top - box.top - 6;
				const dx = sx - ex;
				const dy = ey - sy;
				c1x = sx + 12;
				c1y = sy + dy * 0.75;
				c2x = ex + dx * 0.3;
				c2y = ey - dy * 0.55;
			}
			line.setAttribute('d', `M${sx},${sy} C${c1x},${c1y} ${c2x},${c2y} ${ex},${ey}`);

			// arrowhead along the curve's final direction
			const ang = Math.atan2(ey - c2y, ex - c2x);
			const len = 11;
			const p1 = [ex - len * Math.cos(ang - 0.5), ey - len * Math.sin(ang - 0.5)];
			const p2 = [ex - len * Math.cos(ang + 0.5), ey - len * Math.sin(ang + 0.5)];
			head.setAttribute('d', `M${p1[0]},${p1[1]} L${ex},${ey} L${p2[0]},${p2[1]}`);

			const total = line.getTotalLength();
			svg.style.setProperty('--arrow-len', String(total));
		};

		draw();
		document.fonts?.ready.then(draw);
		new ResizeObserver(draw).observe(main);

		// draws itself in the first time the footer comes into view
		new IntersectionObserver((entries, obs) => {
			if (entries.some((e) => e.isIntersecting)) {
				svg.classList.add('is-drawn');
				obs.disconnect();
			}
		}, { threshold: 0.6 }).observe(main);
	}
</script>

<style>
	/* spans the page, inside the same 4vw side margin as the nav */
	.site-foot {
		width: 100%;
		margin: 7rem 0 0;
		padding: 0 4vw 2.5rem;
		box-sizing: border-box;
	}

	/* two rows: the line, then contacts on the left and buttons + socials on the right */
	.foot-body {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.25rem;
		padding: 2.25rem clamp(1.5rem, 3vw, 3rem) 2.25rem;
		background: var(--pink-soft);
	}

	.foot-body :global(.foot-spark) {
		position: absolute;
		top: 1.1rem;
		right: 1.25rem;
	}

	.foot-line {
		margin: 0;
		padding-right: 2.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.4vw, 2rem);
		letter-spacing: -0.02em;
		font-weight: 600;
		line-height: 1.4;
	}

	.foot-main {
		position: relative;
	}

	.foot-arrow {
		position: absolute;
		inset: 0;
		overflow: visible;
		pointer-events: none;
	}

	.foot-arrow path {
		fill: none;
		stroke: var(--ink);
		stroke-width: 2.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.arrow-line {
		stroke-dasharray: var(--arrow-len, 400);
		stroke-dashoffset: var(--arrow-len, 400);
		transition: stroke-dashoffset 0.9s var(--ease-out) 0.2s;
	}

	.arrow-head {
		opacity: 0;
		transition: opacity 0.2s ease 0.95s;
	}

	.is-drawn .arrow-line {
		stroke-dashoffset: 0;
	}

	.is-drawn .arrow-head {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow-line {
			stroke-dashoffset: 0;
			transition: none;
		}

		.arrow-head {
			opacity: 1;
			transition: none;
		}
	}

	.foot-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		/* room for the arrow to swing down from "vision" */
		margin-top: 3.25rem;
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contact a {
		color: var(--ink);
		font-size: 1.0625rem;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
		font-variant-numeric: tabular-nums;
	}

	.contact a:hover {
		color: var(--pink-deep);
	}

	.foot-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.resume svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.socials {
		display: flex;
		gap: 0.6rem;
	}

	.socials a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
		color: var(--ink);
		transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s var(--ease-out);
	}

	/* the newspaper is a line drawing, unlike the filled GitHub and LinkedIn marks */
	.socials svg.news-icon {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.socials svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
	}

	.socials a:hover {
		background: var(--ink);
		color: var(--white);
		transform: translateY(-2px);
	}

	.contact a:focus-visible,
	.socials a:focus-visible {
		outline: 3px solid var(--white);
		outline-offset: 3px;
	}

	@media (max-width: 760px) {
		.site-foot {
			padding: 0 16px 2rem;
		}
	}

	.copyright {
		margin: 1.5rem 0 0;
		text-align: center;
		font-size: 0.9375rem;
	}
</style>
