---
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';
import TechStack from '../components/TechStack.astro';
import { ThreeDPhotoCarousel } from '../components/ui/3d-carousel';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;

const experience = [
	{
		role: 'Software Development Intern',
		org: 'Siemens',
		about: 'Global technology company; I work on NX, its CAD/CAM software used by engineers worldwide.',
		place: 'Milford, Ohio',
		when: 'Jan 2025 – Present',
		points: [
			'Resolved 50+ customer-reported and internal issues in Siemens NX CAD, boosting stability and cutting the defect backlog by 10%.',
			'Designed and shipped 3 new internal launch methods for NX, reducing Teamcenter integration setup time by 15% for 100+ engineers.',
		],
	},
	{
		role: 'Research Co-Op',
		org: 'Feng Chia University',
		about: 'Research university; summer co-op in computer networking.',
		place: 'Taichung, Taiwan',
		when: 'May – Aug 2024',
		points: [
			'Configured network devices and protocols in Cisco Packet Tracer.',
			'Analysed, troubleshot and fixed protocol connectivity problems.',
		],
	},
	{
		role: 'Software Development Intern',
		org: 'Wolters Kluwer',
		about: 'Global provider of professional information, software and services.',
		place: 'Madison, Wisconsin',
		when: 'Jan – May 2024',
		points: [
			'Took part in daily stand-ups, sprint planning, reviews and retrospectives to keep sprints on track.',
			'Updated NuGet packages and project code to move the team application to a newer .NET framework.',
		],
	},
];
---

<Layout current="home">
	<div id="container">
		<main>
			<!-- the tagline fly-in plays on a visitor's first load only; runs before paint so repeat visits never flash -->
			<script is:inline>
				try {
					if (localStorage.getItem('mt-intro-seen')) document.documentElement.classList.add('intro-seen');
					else localStorage.setItem('mt-intro-seen', '1');
				} catch (e) {}
			</script>
			<header class="intro">
				<div class="me-wrap">
					<img class="me" src={`${base}me.jpg`} alt="Maya Tomarchio" width="600" height="600" />
					<Sparkle size={34} class="me-spark" />
				</div>
				<div class="name-block">
					<Sparkle size={44} class="name-spark-a" delay={0.6} />
					<h1 class="big-name">Maya Tomarchio</h1>
					<p class="tagline">Software Designer + Developer</p>
					<p class="hero-line">Cincinnati, Ohio.</p>
					<Sparkle size={28} class="name-spark-b" delay={1.4} />
				</div>
			</header>
			<div class="star-wrap">
				<img class="halftone-star" src={`${base}halftone_star.png`} alt="" />
			</div>

			<section id="projects" aria-label="Projects">
				<ThreeDPhotoCarousel client:visible projects={projects} />
				<a href={`${base}projects`} class="btn-gloss all-projects">All projects</a>
			</section>

			<div class="stack-wrap">
				<TechStack />
			</div>

			<section id="experience" aria-label="Work experience">
				<ol class="jobs">
					{experience.map((job) => (
						<li>
							<article class="window job">
								<div class="window-bar">
									<span>{job.org.toLowerCase().replace(/[^a-z0-9]+/g, '_')}.exe</span>
									<span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
								</div>
								<div class="job-body">
									<div class="job-top">
										<p class="role">{job.role}</p>
										<p class="when">{job.when}</p>
									</div>
									<h3 class="org">{job.org} <span class="place"><span class="dot" aria-hidden="true">· </span>{job.place}</span></h3>
									<p class="about">{job.about}</p>
									<ul class="points">
										{job.points.map((point) => <li>{point}</li>)}
									</ul>
								</div>
							</article>
						</li>
					))}
				</ol>
			</section>
		</main>
	</div>
</Layout>

<style>
	#container {
		--ink: #111111;

		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
		color: var(--ink);
		/* the tagline swells past the window edges mid-animation; don't let it add a scrollbar */
		overflow-x: clip;
	}

	main {
		min-height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* dotted halftone field from the mood board, faded out toward the edges */
	.intro::before {
		content: '';
		position: absolute;
		inset: -3rem -2rem -9rem;
		z-index: -1;
		background: radial-gradient(var(--ink) 1.1px, transparent 1.4px) 0 0 / 11px 11px;
		opacity: 0.12;
		-webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 72%);
		mask-image: radial-gradient(ellipse at center, #000 30%, transparent 72%);
		pointer-events: none;
	}

	.intro {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 2.5vw, 2.5rem);
		width: 100%;
		margin: 5rem 0 2rem;
		padding: 0 8vw;
		box-sizing: border-box;
	}

	/* chrome ring: a silver-pink conic band around a white inner rim */
	.me-wrap {
		position: relative;
		flex-shrink: 0;
		padding: 5px;
		border-radius: 50%;
		background: conic-gradient(from 210deg, #ffffff, #f7a9cf, #c9c9d6, #ffffff, #ff7fb8, #d8d8e4, #ffffff);
		box-shadow: 0 0 0 2px var(--ink);
		transition: transform 0.4s var(--ease-out);
	}

	.me-wrap:hover {
		transform: rotate(-4deg) scale(1.04);
	}

	.me {
		display: block;
		width: clamp(72px, 7vw, 116px);
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border: 3px solid #ffffff;
		border-radius: 50%;
		background: #ffffff;
	}

	.me-wrap :global(.me-spark) {
		position: absolute;
		top: -10px;
		right: -12px;
	}

	.name-block {
		position: relative;
	}

	.name-block :global(.name-spark-a) {
		position: absolute;
		top: -34px;
		right: -26px;
	}

	.name-block :global(.name-spark-b) {
		position: absolute;
		bottom: 6px;
		left: -8px;
	}

	.hero-line {
		margin: 1.1rem 0 0;
		font-family: var(--font-text);
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		font-weight: 600;
		color: var(--ink);
		text-align: center;
		animation: rise-in 0.8s var(--ease-out) 1.2s both;
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	.star-wrap {
		margin-top: 1rem;
	}

	.halftone-star {
		display: block;
		width: clamp(120px, 12vw, 170px);
		animation: star-spin 40s linear infinite;
	}

	@keyframes star-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-line,
		.halftone-star {
			animation: none;
		}
	}

	:global(.intro-seen) .tagline,
	:global(.intro-seen) .hero-line {
		animation: none;
	}

	.name-block {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* flies in from behind the name, turns about half a turn on the Y axis, then settles */
	.tagline {
		margin: 1rem 0 0;
		font-family: 'Orbitron', 'Space Grotesk', sans-serif;
		font-size: clamp(0.95rem, 1.7vw, 1.6rem);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--cyan);
		/* hard black drop keeps cyan readable on pink, the glow is the Aero part */
		text-shadow:
			0 2px 0 var(--ink),
			0 0 14px rgba(0, 240, 255, 0.45);
		transform-origin: center;
		backface-visibility: visible;
		animation: tagline-in 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
	}

	/* starts just in front of the viewer's face, then travels away into the page and lands, in one move.
	   The perspective lives on the tagline itself so it grows from its own centre and stays level. */
	@keyframes tagline-in {
		0% {
			opacity: 0;
			transform: perspective(900px) translate3d(0, -3px, 820px) rotateY(180deg);
			filter: blur(6px);
		}
		25% {
			opacity: 1;
		}
		100% {
			opacity: 1;
			transform: perspective(900px) translate3d(0, 0, 0) rotateY(0deg);
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tagline {
			animation: none;
		}
	}

	.big-name {
		margin: 0;
		text-align: center;
		font-family: 'Unbounded', 'Arial Black', sans-serif;
		font-size: 5vw;
		white-space: nowrap;
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: #ffffff;
	}

	#projects {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		margin-top: 1.5rem;
		padding: 0 4vw;
		box-sizing: border-box;
	}

	.all-projects {
		margin-top: 2rem;
	}

	.stack-wrap {
		width: 100%;
		max-width: calc(1240px + 16vw);
		margin-top: 7rem;
		padding: 0 8vw;
		box-sizing: border-box;
	}

	/* Work experience: one Y2K window per job, stacked like a resume */
	#experience {
		width: 100%;
		max-width: calc(1240px + 16vw);
		margin-top: 8rem;
		padding: 0 8vw;
		box-sizing: border-box;
		font-family: var(--font-text);
	}

	.jobs {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.job-body {
		padding: 1.75rem clamp(1.25rem, 3vw, 2.5rem) 1.9rem;
		background: var(--pink-soft);
	}

	.job-top {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
	}

	.role {
		margin: 0;
		font-family: var(--font-tech);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.when {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.org {
		margin: 0.7rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2vw, 1.6rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--pink-deep);
	}

	.place {
		font-family: var(--font-text);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--ink);
	}

	.about {
		margin: 0.4rem 0 0;
		font-size: 1rem;
		font-style: italic;
		line-height: 1.5;
	}

	.points {
		display: grid;
		gap: 0.7rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.points li {
		position: relative;
		padding-left: 1.5rem;
		font-size: 1.0625rem;
		line-height: 1.6;
		max-width: 75ch;
	}

	/* small pink play-arrow bullet, like a tracklist */
	.points li::before {
		content: '▸';
		position: absolute;
		left: 0;
		top: 0;
		color: var(--pink-deep);
		font-size: 1.05em;
	}

	/* on phones the tagline gets a lighter shadow and may wrap, so it never touches the edges */
	@media screen and (max-width: 480px) {
		.tagline {
			font-size: clamp(12px, 3.4vw, 15px);
			letter-spacing: 0.08em;
			white-space: normal;
			text-wrap: balance;
			text-align: center;
			text-shadow:
				1px 1px 0 var(--ink),
				0 0 10px rgba(0, 240, 255, 0.4);
		}
	}

	@media screen and (max-width: 768px) {
		/* not enough width for the photo beside the name, so it sits above */
		.intro {
			flex-direction: column;
			margin-top: 4rem;
		}

		.big-name {
			font-size: 7vw;
		}

		.stack-wrap {
			margin-top: 5rem;
			padding: 0 20px;
		}

		#experience {
			margin-top: 6rem;
			padding: 0 20px;
		}

		/* on phones the location gets its own line instead of wrapping after the company */
		.place {
			display: block;
			margin-top: 0.3rem;
		}

		.place .dot {
			display: none;
		}

	}
</style>
