---
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import ProjectField from '../components/ProjectField.astro';
import TechStack from '../components/TechStack.astro';
import { ThreeDPhotoCarousel } from '../components/ui/3d-carousel';
import { getProjects } from '../data/projects';
import { getExperience } from '../data/experience';
import { getLang, t } from '../i18n';
const base = import.meta.env.BASE_URL;

const lang = getLang(Astro.url);
const w = t(lang);
const projects = getProjects(lang);
const experience = getExperience(lang);
---

<Layout current="home">
	<!-- the projects gallery lives just off the left edge of home -->
	<ProjectsGallery slot="left" />
	<!-- and every project's page, scattered on the canvas below -->
	<ProjectField slot="below" />
	<div id="container">
		<!-- binary-code stars in the top-left corner, behind everything but the pink page -->
		<img class="bg-star" src={`${base}binary-star.png`} alt="" aria-hidden="true" width="276" height="299" />
		<main>
			<!-- the tagline fly-in plays on a visitor's first load only; runs before paint so repeat visits never flash -->
			<script is:inline>
				try {
					if (localStorage.getItem('mt-intro-seen')) document.documentElement.classList.add('intro-seen');
					else localStorage.setItem('mt-intro-seen', '1');
				} catch (e) {}
			</script>
			<header class="intro">
				<div class="me-wrap">
					<!-- clicking the headshot pans over to the guest book -->
					<a class="me-link" href="#book" aria-label={w('home.headshot')}>
						<img class="me" src={`${base}me.jpg`} alt="" width="600" height="600" />
					</a>
					<Sparkle size={34} class="me-spark" />
				</div>
				<div class="name-block">
					<Sparkle size={44} class="name-spark-a" delay={0.6} />
					<h1 class="big-name">Maya Tomarchio</h1>
					<p class="tagline">{w('home.tagline')}</p>
					<p class="hero-line">{w('home.location')}</p>
					<Sparkle size={28} class="name-spark-b" delay={1.4} />
				</div>
			</header>
			<div class="star-wrap">
				<img class="halftone-star" src={`${base}halftone_star.png`} alt="" />
			</div>

			<section id="projects" aria-label={w('home.projects')}>
				<!-- a second binary star, mirrored, tucked behind the carousel's bottom-right corner -->
				<img class="bg-star bg-star-2" src={`${base}binary-star.png`} alt="" aria-hidden="true" width="276" height="299" />
				<ThreeDPhotoCarousel client:visible projects={projects} labels={{ prev: w('carousel.prev'), next: w('carousel.next') }} />
				<!-- the guest book lies level with this button, just off the right edge (see BookBay) -->
				<a href="#projects" class="btn-gloss all-projects" data-book-anchor>{w('home.allProjects')}</a>
			</section>

			<div class="stack-wrap">
				<TechStack />
			</div>

			<section id="experience" aria-labelledby="experience-title">
				<h2 id="experience-title" class="section-title">{w('home.experience')}</h2>
				<ol class="jobs">
					{experience.map((job) => (
						<li>
							<article class="job">
								<div class="job-body">
									<div class="job-top">
										<div>
											<p class="role">{job.role}</p>
											<h3 class="org">{job.org}</h3>
										</div>
										<div class="job-meta">
											<p class="when">{job.when}</p>
											<p class="place">{job.place}</p>
										</div>
									</div>
									{/* no "about" line: keep the same breathing room before the bullet points */}
									{job.about ? <p class="about">{job.about}</p> : <div class="about-gap" aria-hidden="true"></div>}
									<ul class="points">
										{job.points.map((point) => <li>{point}</li>)}
									</ul>
								</div>
							</article>
						</li>
					))}
				</ol>
			</section>
		</main>
	</div>
</Layout>

<style>
	#container {
		--ink: #111111;

		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: var(--ink);
		/* the tagline swells past the window edges mid-animation; don't let it add a scrollbar */
		overflow-x: clip;
	}

	.bg-star {
		position: absolute;
		top: -1.5rem;
		left: -2.5rem;
		z-index: -2;
		width: clamp(240px, 30vw, 440px);
		height: auto;
		opacity: 0.3;
		transform: rotate(-8deg);
		pointer-events: none;
		user-select: none;
	}

	/* the opposite corner: down by the carousel's bottom right, flipped so the two don't look stamped */
	.bg-star-2 {
		top: auto;
		left: auto;
		right: 1vw;
		bottom: -5rem;
		width: clamp(200px, 24vw, 360px);
		transform: scaleX(-1) rotate(-10deg);
	}

	@media (max-width: 768px) {
		.bg-star {
			top: -1rem;
			left: -3rem;
			width: 230px;
			opacity: 0.22;
		}

		.bg-star-2 {
			top: auto;
			left: auto;
			right: -2.5rem;
			bottom: -3rem;
			width: 190px;
		}
	}

	main {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* dotted halftone field from the mood board, faded out toward the edges */
	.intro::before {
		content: '';
		position: absolute;
		inset: -3rem -2rem -9rem;
		z-index: -1;
		background: radial-gradient(var(--ink) 1.1px, transparent 1.4px) 0 0 / 11px 11px;
		opacity: 0.12;
		-webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 72%);
		mask-image: radial-gradient(ellipse at center, #000 30%, transparent 72%);
		pointer-events: none;
	}

	.intro {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 2.5vw, 2.5rem);
		width: 100%;
		margin: 5rem 0 2rem;
		padding: 0 8vw;
		box-sizing: border-box;
	}

	/* chrome ring: a silver-pink conic band around a white inner rim */
	.me-wrap {
		position: relative;
		flex-shrink: 0;
		padding: 5px;
		border-radius: 50%;
		background: conic-gradient(from 210deg, #ffffff, #f7a9cf, #c9c9d6, #ffffff, #ff7fb8, #d8d8e4, #ffffff);
		box-shadow: 0 0 0 2px var(--ink);
		transition: transform 0.4s var(--ease-out);
	}

	.me-wrap:hover {
		transform: rotate(-4deg) scale(1.04);
	}

	.me-link {
		display: block;
		border-radius: 50%;
		transition: transform 0.25s var(--ease-out);
	}

	.me-link:hover {
		transform: rotate(-4deg) scale(1.04);
	}

	.me-link:focus-visible {
		outline: 3px solid var(--white);
		outline-offset: 4px;
	}

	.me {
		display: block;
		width: clamp(72px, 7vw, 116px);
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border: 3px solid #ffffff;
		border-radius: 50%;
		background: #ffffff;
	}

	.me-wrap :global(.me-spark) {
		position: absolute;
		top: -10px;
		right: -12px;
	}

	.name-block {
		position: relative;
	}

	.name-block :global(.name-spark-a) {
		position: absolute;
		top: -34px;
		right: -26px;
	}

	.name-block :global(.name-spark-b) {
		position: absolute;
		bottom: 6px;
		left: -8px;
	}

	.hero-line {
		margin: 1.1rem 0 0;
		font-family: var(--font-text);
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		font-weight: 600;
		color: var(--ink);
		text-align: center;
		animation: rise-in 0.8s var(--ease-out) 1.2s both;
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	.star-wrap {
		margin-top: 1rem;
	}

	.halftone-star {
		display: block;
		width: clamp(120px, 12vw, 170px);
		animation: star-spin 40s linear infinite;
	}

	@keyframes star-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-line,
		.halftone-star {
			animation: none;
		}
	}

	:global(.intro-seen) .tagline,
	:global(.intro-seen) .hero-line {
		animation: none;
	}

	.name-block {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* flies in from behind the name, turns about half a turn on the Y axis, then settles */
	.tagline {
		margin: 1rem 0 0;
		font-family: 'Orbitron', 'Space Grotesk', sans-serif;
		font-size: clamp(0.95rem, 1.7vw, 1.6rem);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--cyan);
		/* hard black drop keeps cyan readable on pink, the glow is the Aero part */
		text-shadow:
			0 2px 0 var(--ink),
			0 0 14px rgba(0, 240, 255, 0.45);
		transform-origin: center;
		backface-visibility: visible;
		animation: tagline-in 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
	}

	/* starts just in front of the viewer's face, then travels away into the page and lands, in one move.
	   The perspective lives on the tagline itself so it grows from its own centre and stays level. */
	@keyframes tagline-in {
		0% {
			opacity: 0;
			transform: perspective(900px) translate3d(0, -3px, 820px) rotateY(180deg);
			filter: blur(6px);
		}
		25% {
			opacity: 1;
		}
		100% {
			opacity: 1;
			transform: perspective(900px) translate3d(0, 0, 0) rotateY(0deg);
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tagline {
			animation: none;
		}
	}

	.big-name {
		margin: 0;
		text-align: center;
		font-family: 'Unbounded', 'Arial Black', sans-serif;
		font-size: 5vw;
		white-space: nowrap;
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: #ffffff;
	}

	#projects {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		margin-top: 1.5rem;
		padding: 0 4vw;
		box-sizing: border-box;
	}

	.all-projects {
		margin-top: 2rem;
	}

	.stack-wrap {
		width: 100%;
		max-width: calc(1240px + 16vw);
		margin-top: 7rem;
		padding: 0 8vw;
		box-sizing: border-box;
	}

	/* Work experience: one Y2K window per job, stacked like a resume */
	#experience {
		width: 100%;
		max-width: calc(1240px + 16vw);
		margin-top: 8rem;
		padding: 0 8vw;
		box-sizing: border-box;
		font-family: var(--font-text);
	}

	.section-title {
		margin: 0 0 2rem;
		padding-bottom: 0.9rem;
		border-bottom: var(--line);
		font-family: var(--font-display);
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: var(--white);
	}

	/* cards step left, right, left down the page */
	.jobs {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.jobs > li {
		width: min(100%, 52rem);
	}

	.jobs > li:nth-child(even) {
		justify-self: end;
	}

	/* soft card: thin black line, rounded, the same light pink as the footer */
	.job {
		border: 2px solid var(--ink);
		border-radius: 18px;
		background: var(--pink-soft);
	}

	.job-body {
		padding: 1.75rem clamp(1.25rem, 3vw, 2.5rem) 1.9rem;
	}

	/* role + company on the left; dates with the location under them on the right, both left-aligned */
	.job-top {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}

	.job-meta {
		text-align: left;
	}

	.role {
		margin: 0;
		font-family: var(--font-tech);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.when {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.org {
		margin: 0.7rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2vw, 1.6rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--pink-deep);
	}

	.place {
		margin: 0.3rem 0 0;
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.about-gap {
		height: 0.9rem;
	}

	.about {
		margin: 0.4rem 0 0;
		font-size: 1rem;
		font-style: italic;
		line-height: 1.5;
	}

	.points {
		display: grid;
		gap: 0.7rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.points li {
		position: relative;
		padding-left: 1.5rem;
		font-size: 1.0625rem;
		line-height: 1.6;
		max-width: 75ch;
	}

	/* small pink play-arrow bullet, like a tracklist */
	.points li::before {
		content: '▸';
		position: absolute;
		left: 0;
		top: 0;
		color: var(--pink-deep);
		font-size: 1.05em;
	}

	/* on phones the tagline gets a lighter shadow and may wrap, so it never touches the edges */
	@media screen and (max-width: 480px) {
		.tagline {
			font-size: clamp(12px, 3.4vw, 15px);
			letter-spacing: 0.08em;
			white-space: normal;
			text-wrap: balance;
			text-align: center;
			text-shadow:
				1px 1px 0 var(--ink),
				0 0 10px rgba(0, 240, 255, 0.4);
		}
	}

	@media screen and (max-width: 768px) {
		/* not enough width for the photo beside the name, so it sits above */
		.intro {
			flex-direction: column;
			margin-top: 4rem;
		}

		.big-name {
			font-size: 7vw;
		}

		.stack-wrap {
			margin-top: 5rem;
			padding: 0 20px;
		}

		#experience {
			margin-top: 6rem;
			padding: 0 20px;
		}


	}
</style>
