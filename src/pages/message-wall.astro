---
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';

const stickers = [
	{ id: 'sparkle', label: 'Sparkle' },
	{ id: 'star', label: 'Star' },
	{ id: 'heart', label: 'Heart' },
	{ id: 'bubble', label: 'Bubble' },
];
const colors = [
	{ id: 'pink', label: 'Pink' },
	{ id: 'cyan', label: 'Cyan' },
	{ id: 'white', label: 'White' },
];
---

<Layout current="wall" title="Message wall">
	<main class="wall-page">
		<header class="page-head">
			<h1>Message<span class="spark-anchor"><Sparkle size={44} class="head-spark" /></span> wall</h1>
			<p class="lede"></p>
		</header>

		<p class="preview-note" id="preview-note" hidden>
		</p>

		<div class="wall-layout">
			<section class="window compose" aria-labelledby="compose-title">
				<div class="window-bar">
					<span id="compose-title">new_message.exe</span>
					<span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
				</div>
				<form id="wall-form" class="compose-body" novalidate>
					<label class="field">
						<span>Your name</span>
						<input name="name" type="text" maxlength="40" autocomplete="name" required />
					</label>

					<label class="field">
						<span>Message</span>
						<textarea name="message" rows="5" maxlength="280" required aria-describedby="count"></textarea>
						<span class="count" id="count">0 / 280</span>
					</label>

					<fieldset class="picker">
						<legend>Sticker</legend>
						<div class="options">
							{stickers.map((s, i) => (
								<label class="option sticker-option">
									<input type="radio" name="sticker" value={s.id} checked={i === 0} />
									<span class="chip" data-sticker={s.id}><span class="visually-hidden">{s.label}</span></span>
								</label>
							))}
						</div>
					</fieldset>

					<fieldset class="picker">
						<legend>Note colour</legend>
						<div class="options">
							{colors.map((c, i) => (
								<label class="option">
									<input type="radio" name="color" value={c.id} checked={i === 0} />
									<span class={`swatch swatch-${c.id}`}><span class="visually-hidden">{c.label}</span></span>
								</label>
							))}
						</div>
					</fieldset>

					<!-- bots fill every field; people never see this one -->
					<label class="trap" aria-hidden="true">
						Leave empty <input name="website" type="text" tabindex="-1" autocomplete="off" />
					</label>

					<button type="submit" class="btn-gloss">Post to the wall</button>
					<p class="status" id="status" role="status" aria-live="polite"></p>
				</form>
			</section>

			<section class="board" aria-labelledby="board-title">
				<h2 id="board-title" class="visually-hidden">Messages</h2>
				<p class="empty" id="empty">No messages yet. Be the first to sign the wall.</p>
				<ul class="notes" id="notes"></ul>
			</section>
		</div>
	</main>
</Layout>

<script>
	type Note = { id: number | string; name: string; message: string; sticker: string; color: string; created_at: string };

	const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
	const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
	const live = Boolean(SUPABASE_URL && SUPABASE_KEY && !SUPABASE_URL.includes('your-project-ref'));
	const LOCAL_KEY = 'mt-wall-preview';
	const COOLDOWN_KEY = 'mt-wall-last-post';
	const COOLDOWN_MS = 30_000;

	const STICKERS: Record<string, string> = {
		sparkle: '<path d="M12 0c1 7.5 4.5 11 12 12-7.5 1-11 4.5-12 12-1-7.5-4.5-11-12-12C7.5 11 11 7.5 12 0z"/>',
		star: '<path d="M12 1.5l3.1 6.6 7.2.9-5.3 5 1.4 7.1L12 17.6l-6.4 3.5L7 14l-5.3-5 7.2-.9z"/>',
		heart: '<path d="M12 21.4l-1.5-1.3C5 15.2 1.5 12 1.5 8.1 1.5 5 4 2.5 7.1 2.5c1.8 0 3.5.8 4.9 2.1 1.4-1.3 3.1-2.1 4.9-2.1 3.1 0 5.6 2.5 5.6 5.6 0 3.9-3.5 7.1-9 12z"/>',
		bubble: '<circle cx="12" cy="12" r="10"/><ellipse cx="8.5" cy="7.5" rx="3.2" ry="2" fill="#fff" opacity=".85"/>',
	};

	const form = document.querySelector<HTMLFormElement>('#wall-form')!;
	const list = document.querySelector<HTMLUListElement>('#notes')!;
	const empty = document.querySelector<HTMLParagraphElement>('#empty')!;
	const status = document.querySelector<HTMLParagraphElement>('#status')!;
	const count = document.querySelector<HTMLSpanElement>('#count')!;
	const textarea = form.querySelector<HTMLTextAreaElement>('textarea')!;
	const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

	document.querySelectorAll<HTMLElement>('.chip[data-sticker]').forEach((chip) => {
		chip.insertAdjacentHTML('afterbegin', `<svg viewBox="0 0 24 24" aria-hidden="true">${STICKERS[chip.dataset.sticker!]}</svg>`);
	});

	if (!live) document.querySelector<HTMLElement>('#preview-note')!.hidden = false;

	const headers = () => ({
		apikey: SUPABASE_KEY!,
		Authorization: `Bearer ${SUPABASE_KEY}`,
		'Content-Type': 'application/json',
	});

	const readLocal = (): Note[] => {
		try {
			return JSON.parse(localStorage.getItem(LOCAL_KEY) ?? '[]');
		} catch {
			return [];
		}
	};

	async function loadNotes(): Promise<Note[]> {
		if (!live) return readLocal();
		const res = await fetch(
			`${SUPABASE_URL}/rest/v1/messages?select=id,name,message,sticker,color,created_at&order=created_at.desc&limit=200`,
			{ headers: headers() },
		);
		if (!res.ok) throw new Error(`Load failed: ${res.status}`);
		return res.json();
	}

	async function saveNote(note: Omit<Note, 'id' | 'created_at'>): Promise<Note> {
		if (!live) {
			const saved = { ...note, id: Date.now(), created_at: new Date().toISOString() };
			try {
				localStorage.setItem(LOCAL_KEY, JSON.stringify([saved, ...readLocal()].slice(0, 200)));
			} catch {
				/* storage blocked: the note still shows until the page reloads */
			}
			return saved;
		}
		const res = await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
			method: 'POST',
			headers: { ...headers(), Prefer: 'return=representation' },
			body: JSON.stringify(note),
		});
		if (!res.ok) throw new Error(`Post failed: ${res.status}`);
		return (await res.json())[0];
	}

	const formatDate = (iso: string) =>
		new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });

	function renderNote(note: Note, fresh = false) {
		const li = document.createElement('li');
		li.className = `note note-${['pink', 'cyan', 'white'].includes(note.color) ? note.color : 'pink'}`;
		if (fresh) li.classList.add('is-new');

		const sticker = document.createElement('span');
		sticker.className = 'note-sticker';
		sticker.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${STICKERS[note.sticker] ?? STICKERS.sparkle}</svg>`;

		const msg = document.createElement('p');
		msg.className = 'note-message';
		msg.textContent = note.message;

		const meta = document.createElement('p');
		meta.className = 'note-meta';
		const who = document.createElement('strong');
		who.textContent = note.name;
		const when = document.createElement('time');
		when.dateTime = note.created_at;
		when.textContent = formatDate(note.created_at);
		meta.append(who, when);

		li.append(sticker, msg, meta);
		return li;
	}

	function render(notes: Note[]) {
		list.replaceChildren(...notes.map((n) => renderNote(n)));
		empty.hidden = notes.length > 0;
	}

	textarea.addEventListener('input', () => {
		count.textContent = `${textarea.value.length} / 280`;
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (String(data.get('website') ?? '')) return;

		const name = String(data.get('name') ?? '').trim();
		const message = String(data.get('message') ?? '').trim();
		if (!name || !message) {
			status.textContent = !name ? 'Add your name first.' : 'Write a message first.';
			(form.elements.namedItem(!name ? 'name' : 'message') as HTMLElement).focus();
			return;
		}

		const last = Number(localStorage.getItem(COOLDOWN_KEY) ?? 0);
		if (Date.now() - last < COOLDOWN_MS) {
			status.textContent = 'Thanks! Give it a few seconds before posting again.';
			return;
		}

		submit.disabled = true;
		status.textContent = 'Posting…';
		try {
			const saved = await saveNote({
				name,
				message,
				sticker: String(data.get('sticker') ?? 'sparkle'),
				color: String(data.get('color') ?? 'pink'),
			});
			try {
				localStorage.setItem(COOLDOWN_KEY, String(Date.now()));
			} catch {
				/* no storage: skip the cooldown */
			}
			list.prepend(renderNote(saved, true));
			empty.hidden = true;
			form.reset();
			count.textContent = '0 / 280';
			status.textContent = 'Posted. Thank you for signing the wall!';
		} catch (error) {
			console.error(error);
			status.textContent = 'That didn’t post. Please try again in a moment.';
		} finally {
			submit.disabled = false;
		}
	});

	loadNotes()
		.then(render)
		.catch((error) => {
			console.error(error);
			empty.textContent = 'The wall couldn’t load right now. Please try again later.';
		});
</script>

<style>
	.wall-page {
		max-width: 1240px;
		margin: 0 auto;
		padding: 3.5rem 8vw 0;
	}

	.page-head {
		position: relative;
		max-width: 46rem;
		margin-bottom: 3rem;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: var(--white);
	}

	/* zero-width hook at the end of "Message" so the sparkle sits on that word's top-right corner */
	.spark-anchor {
		position: relative;
		display: inline-block;
		width: 0;
		height: 0;
	}

	.spark-anchor :global(.head-spark) {
		position: absolute;
		bottom: 0.35em;
		left: -6px;
	}

	.lede {
		margin: 1.25rem 0 0;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.preview-note {
		margin: 0 0 2rem;
		padding: 0.9rem 1.1rem;
		border: 2px dashed var(--ink);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.35);
		font-size: 1rem;
	}

	.wall-layout {
		display: grid;
		grid-template-columns: minmax(300px, 380px) 1fr;
		gap: 3rem;
		align-items: start;
	}

	.compose {
		position: sticky;
		top: 1.5rem;
	}

	.compose-body {
		display: grid;
		gap: 1.1rem;
		padding: 1.4rem;
		background: var(--pink-soft);
	}

	.field {
		position: relative;
		display: grid;
		gap: 0.4rem;
		font-weight: 600;
	}

	.field input,
	.field textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 0.75rem 0.9rem;
		border: 2px solid var(--ink);
		border-radius: 10px;
		background: var(--white);
		color: var(--ink);
		font: inherit;
		font-weight: 400;
	}

	.field textarea {
		resize: vertical;
		min-height: 7.5rem;
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		outline: 3px solid var(--cyan);
		outline-offset: 1px;
	}

	.count {
		justify-self: end;
		font-size: 0.875rem;
		font-weight: 400;
		font-variant-numeric: tabular-nums;
	}

	.picker {
		margin: 0;
		padding: 0;
		border: 0;
	}

	.picker legend {
		padding: 0;
		margin-bottom: 0.5rem;
		font-weight: 600;
	}

	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.option input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.chip,
	.swatch {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
		transition: transform 0.2s var(--ease-out), box-shadow 0.2s ease;
	}

	.chip :global(svg) {
		width: 1.4rem;
		height: 1.4rem;
		fill: var(--pink);
		stroke: var(--ink);
		stroke-width: 1;
	}

	.swatch-pink {
		background: #ff8fc0;
	}

	.swatch-cyan {
		background: var(--cyan);
	}

	.swatch-white {
		background: var(--white);
	}

	.option:hover .chip,
	.option:hover .swatch {
		transform: translateY(-2px);
	}

	.option input:checked + .chip,
	.option input:checked + .swatch {
		box-shadow: 0 0 0 3px var(--pink-soft), 0 0 0 6px var(--ink);
	}

	.option input:focus-visible + .chip,
	.option input:focus-visible + .swatch {
		outline: 3px solid var(--cyan);
		outline-offset: 6px;
	}

	.trap {
		position: absolute;
		left: -9999px;
	}

	.compose .btn-gloss {
		justify-self: start;
	}

	.status {
		min-height: 1.4em;
		margin: 0;
		font-size: 1rem;
	}

	.empty {
		margin: 0;
		padding: 3rem 1.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		text-align: center;
	}

	/* dotted grid board behind the notes */
	.board {
		align-self: stretch;
		box-sizing: border-box;
		min-height: 22rem;
		padding: 1.5rem;
		border: 2px solid var(--ink);
		border-radius: 14px;
		background: radial-gradient(rgba(17, 17, 17, 0.22) 1.2px, transparent 1.5px) 0 0 / 18px 18px,
			rgba(255, 255, 255, 0.12);
	}

	.notes {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 2rem 1.5rem;
		align-items: start;
		margin: 0;
		padding: 0.75rem 0 0;
		list-style: none;
	}

	.notes :global(.note) {
		position: relative;
		margin: 0;
		padding: 1.4rem 1.3rem 1.1rem;
		border: 2px solid var(--ink);
		border-radius: 14px;
		background: #ff9ccb;
		transform: rotate(-0.8deg);
		transition: transform 0.25s var(--ease-out);
	}

	.notes :global(.note:nth-child(3n + 2)) {
		transform: rotate(0.9deg);
	}

	.notes :global(.note:nth-child(3n)) {
		transform: rotate(-0.3deg);
	}

	.notes :global(.note:hover) {
		transform: rotate(0deg) translateY(-3px);
	}

	.notes :global(.note-cyan) {
		background: #8ff6ff;
	}

	.notes :global(.note-white) {
		background: var(--white);
	}

	.notes :global(.note.is-new) {
		animation: note-in 0.6s var(--ease-out) both;
	}

	@keyframes note-in {
		from {
			opacity: 0;
			transform: translateY(-16px) scale(0.94);
		}
	}

	.notes :global(.note-sticker) {
		position: absolute;
		top: -14px;
		right: 14px;
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
	}

	.notes :global(.note-sticker svg) {
		width: 1.2rem;
		height: 1.2rem;
		fill: var(--pink);
		stroke: var(--ink);
		stroke-width: 1;
	}

	.notes :global(.note-message) {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.notes :global(.note-meta) {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0.9rem 0 0;
		font-size: 0.9375rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.notes :global(.note.is-new) {
			animation: none;
		}
	}

	@media (max-width: 860px) {
		.wall-layout {
			grid-template-columns: 1fr;
		}

		.compose {
			position: static;
		}
	}

	@media (max-width: 768px) {
		.wall-page {
			padding: 2.5rem 20px 0;
		}
	}
</style>
