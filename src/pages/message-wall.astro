---
import Layout from '../layouts/Layout.astro';
import { getLang, localize, t } from '../i18n';

const lang = getLang(Astro.url);
const w = t(lang);
// the words the wall's script shows, in this page's language
const words = {
	mine: w('wall.mine'),
	edit: w('wall.edit'),
	write: w('wall.write'),
	locked: w('wall.locked'),
	saved: w('wall.saved'),
	removed: w('wall.removed'),
	wait: w('wall.wait'),
	savedEdit: w('wall.savedEdit'),
	failed: w('wall.failed'),
	loadFailed: w('wall.loadFailed'),
};
---

<Layout current="wall" title={w('wall.title')} bare>
	<main class="wall-page">
		<h1 class="visually-hidden">{w('wall.title')}</h1>
		<!-- back to the guest book, just off the right edge of the home page -->
		<div class="back">
			<a class="btn-gloss" href={`${localize(lang)}#book`} aria-label={w('wall.back')}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
				<span>{w('wall.backText')}</span>
			</a>
		</div>

		<!--
			One big sheet of lined paper. Click (or tap) anywhere on it to start writing there; Enter or clicking away saves.
			Notes you wrote in this browser session stay editable; everyone else's are read-only.
		-->
		<section class="paper" id="paper" aria-label={w('wall.paper')} data-words={JSON.stringify(words)}>
		</section>
		<p class="status" id="status" role="status" aria-live="polite"></p>
	</main>
</Layout>

<script>
	type Note = { id: string; x: number; line: number; body: string };

	const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
	const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
	const live = Boolean(SUPABASE_URL && SUPABASE_KEY && !SUPABASE_URL.includes('your-project-ref'));

	const LOCAL_KEY = 'mt-wall-notes'; // preview mode only: every note, in this browser
	const MINE_KEY = 'mt-wall-mine'; // this browser session's notes: id -> edit token
	const COOLDOWN_KEY = 'mt-wall-last-post';
	const COOLDOWN_MS = 3_000;
	const MAX_LEN = 280;
	const MAX_LINE = 2000;
	const SPARE_LINES = 12; // blank paper kept below the lowest note so there's always room to write

	const paper = document.querySelector<HTMLElement>('#paper')!;
	const words: Record<string, string> = JSON.parse(paper.dataset.words ?? '{}');

	// opened in the homepage's overlay: the back button (and Escape) close the overlay instead of leaving
	const embedded = window.self !== window.top;
	if (embedded) {
		const close = () => parent.postMessage({ type: 'wall:close' }, location.origin);
		document.querySelector<HTMLAnchorElement>('.back a')?.addEventListener('click', (e) => {
			e.preventDefault();
			close();
		});
		addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !(e.target as HTMLElement).closest('textarea')) close();
		});
	}
	const hint = document.querySelector<HTMLElement>('#hint'); // optional
	const status = document.querySelector<HTMLElement>('#status')!;
	const writeBtn = document.querySelector<HTMLButtonElement>('#write-btn'); // optional keyboard route

	// the rule spacing comes from CSS so the notes always sit on the lines
	const lineHeight = () => parseFloat(getComputedStyle(paper).getPropertyValue('--rule')) || 32;
	const topMargin = () => parseFloat(getComputedStyle(paper).getPropertyValue('--top')) || 64;

	const notes = new Map<string, Note>();
	const elements = new Map<string, HTMLElement>();

	// ---------- storage ----------

	const safeGet = (store: Storage, key: string) => {
		try {
			return store.getItem(key);
		} catch {
			return null;
		}
	};
	const safeSet = (store: Storage, key: string, value: string) => {
		try {
			store.setItem(key, value);
		} catch {
			/* storage blocked: things still work until the page reloads */
		}
	};

	const mine: Record<string, string> = JSON.parse(safeGet(sessionStorage, MINE_KEY) ?? '{}');
	const rememberMine = (id: string, token: string | null) => {
		if (token) mine[id] = token;
		else delete mine[id];
		safeSet(sessionStorage, MINE_KEY, JSON.stringify(mine));
	};

	type StoredLocal = Note & { token: string };
	const readLocal = (): StoredLocal[] => {
		try {
			return JSON.parse(safeGet(localStorage, LOCAL_KEY) ?? '[]');
		} catch {
			return [];
		}
	};
	const writeLocal = (list: StoredLocal[]) => safeSet(localStorage, LOCAL_KEY, JSON.stringify(list));

	const headers = () => ({
		apikey: SUPABASE_KEY!,
		Authorization: `Bearer ${SUPABASE_KEY}`,
		'Content-Type': 'application/json',
	});

	async function rpc<T>(name: string, args: Record<string, unknown>): Promise<T> {
		const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/${name}`, {
			method: 'POST',
			headers: headers(),
			body: JSON.stringify(args),
		});
		if (!res.ok) throw new Error(`${name} failed: ${res.status}`);
		return res.json();
	}

	async function loadNotes(): Promise<Note[]> {
		if (!live) return readLocal().map(({ token, ...note }) => note);
		const res = await fetch(
			`${SUPABASE_URL}/rest/v1/wall_notes?select=id,x,line,body&order=created_at.asc&limit=2000`,
			{ headers: headers() },
		);
		if (!res.ok) throw new Error(`Load failed: ${res.status}`);
		return res.json();
	}

	// new notes get an edit token from the server; only this session knows it
	async function addNote(x: number, line: number, body: string): Promise<{ note: Note; token: string }> {
		if (!live) {
			const note = { id: crypto.randomUUID(), x, line, body };
			const token = crypto.randomUUID();
			writeLocal([...readLocal(), { ...note, token }]);
			return { note, token };
		}
		const [row] = await rpc<{ id: string; token: string }[]>('add_wall_note', { p_x: x, p_line: line, p_body: body });
		return { note: { id: row.id, x, line, body }, token: row.token };
	}

	// an empty body removes the note; the server only allows it with that note's token
	async function editNote(id: string, token: string, body: string): Promise<boolean> {
		if (!live) {
			const list = readLocal();
			const i = list.findIndex((n) => n.id === id && n.token === token);
			if (i < 0) return false;
			if (body) list[i].body = body;
			else list.splice(i, 1);
			writeLocal(list);
			return true;
		}
		return rpc<boolean>('edit_wall_note', { p_id: id, p_token: token, p_body: body });
	}

	// ---------- drawing ----------

	function place(el: HTMLElement, x: number, line: number) {
		el.style.left = `${x * 100}%`;
		el.style.top = `${topMargin() + line * lineHeight()}px`;
		el.style.maxWidth = `calc(${(1 - x) * 100}% - 1rem)`;
	}

	function fitPaper() {
		let lowest = 0;
		elements.forEach((el) => {
			lowest = Math.max(lowest, el.offsetTop + el.offsetHeight);
		});
		paper.style.minHeight = `max(100dvh, ${lowest + SPARE_LINES * lineHeight()}px)`;
		if (hint) hint.hidden = notes.size > 0;
	}

	function drawNote(note: Note) {
		let el = elements.get(note.id);
		if (!el) {
			el = document.createElement('p');
			el.className = 'note';
			el.dataset.id = note.id;
			paper.append(el);
			elements.set(note.id, el);
		}
		el.textContent = note.body;
		el.classList.toggle('is-mine', note.id in mine);
		if (note.id in mine) {
			el.tabIndex = 0;
			el.title = words.mine;
			el.setAttribute('role', 'button');
		}
		place(el, note.x, note.line);
	}

	// ---------- writing ----------

	let draft: HTMLTextAreaElement | null = null;

	function openEditor(x: number, line: number, editing?: Note) {
		// moving to a new spot keeps whatever was being written
		if (draft) closeEditor(true);
		const ta = document.createElement('textarea');
		ta.className = 'note note-draft';
		ta.maxLength = MAX_LEN;
		ta.rows = 1;
		ta.spellcheck = true;
		ta.setAttribute('aria-label', editing ? words.edit : words.write);
		ta.value = editing?.body ?? '';
		ta.dataset.x = String(x);
		ta.dataset.line = String(line);
		if (editing) {
			ta.dataset.id = editing.id;
			elements.get(editing.id)!.hidden = true;
		}
		place(ta, x, line);
		paper.append(ta);
		draft = ta;
		if (hint) hint.hidden = true;

		const grow = () => {
			ta.style.height = '0';
			ta.style.height = `${Math.ceil(ta.scrollHeight / lineHeight()) * lineHeight()}px`;
		};
		grow();
		ta.addEventListener('input', grow);
		ta.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && !e.shiftKey) {
				e.preventDefault();
				closeEditor(true);
			} else if (e.key === 'Escape') {
				e.preventDefault();
				closeEditor(false);
			}
		});
		ta.addEventListener('blur', () => {
			// let a click that moved focus elsewhere on the paper finish first
			setTimeout(() => draft === ta && closeEditor(true), 0);
		});
		ta.focus();
		ta.setSelectionRange(ta.value.length, ta.value.length);
	}

	async function closeEditor(save: boolean) {
		const ta = draft;
		if (!ta) return;
		draft = null;
		const body = ta.value.trim().slice(0, MAX_LEN);
		const id = ta.dataset.id;
		const x = Number(ta.dataset.x);
		const line = Number(ta.dataset.line);
		ta.remove();
		const old = id ? elements.get(id) : undefined;
		if (old) old.hidden = false;

		if (!save) return fitPaper();

		try {
			if (id) {
				const note = notes.get(id)!;
				if (body === note.body) return fitPaper();
				const ok = await editNote(id, mine[id], body);
				if (!ok) {
					rememberMine(id, null);
					drawNote(note);
					say(words.locked);
				} else if (body) {
					note.body = body;
					drawNote(note);
					say(words.saved);
				} else {
					notes.delete(id);
					elements.get(id)?.remove();
					elements.delete(id);
					rememberMine(id, null);
					say(words.removed);
				}
			} else if (body) {
				const last = Number(safeGet(localStorage, COOLDOWN_KEY) ?? 0);
				if (Date.now() - last < COOLDOWN_MS) {
					// too quick: keep the words open in place instead of losing them
					say(words.wait);
					openEditor(x, line);
					draft!.value = body;
					draft!.dispatchEvent(new Event('input'));
					return;
				}
				const { note, token } = await addNote(x, line, body);
				safeSet(localStorage, COOLDOWN_KEY, String(Date.now()));
				rememberMine(note.id, token);
				notes.set(note.id, note);
				drawNote(note);
				say(words.savedEdit);
			}
		} catch (error) {
			console.error(error);
			say(words.failed);
		}
		fitPaper();
	}

	let sayTimer = 0;
	function say(text: string) {
		status.textContent = text;
		clearTimeout(sayTimer);
		sayTimer = window.setTimeout(() => (status.textContent = ''), 4000);
	}

	// where on the paper a click lands, snapped to a ruled line
	function spot(e: MouseEvent) {
		const box = paper.getBoundingClientRect();
		const minX = 12 / box.width;
		const maxX = Math.max(minX, 1 - 160 / box.width); // leave room for a few words
		const x = Math.min(Math.max((e.clientX - box.left - 4) / box.width, minX), maxX);
		const line = Math.floor((e.clientY - box.top - topMargin()) / lineHeight());
		return { x: Math.round(x * 1000) / 1000, line: Math.min(Math.max(line, 0), MAX_LINE) };
	}

	paper.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (target.closest('.note-draft, .write-btn')) return;
		const noteEl = target.closest<HTMLElement>('.note');
		if (noteEl) {
			// your own notes open for editing; other people's are read-only
			const note = notes.get(noteEl.dataset.id!);
			if (note && note.id in mine) openEditor(note.x, note.line, note);
			return;
		}
		const { x, line } = spot(e);
		if (line < 0) return;
		openEditor(x, line);
	});

	paper.addEventListener('keydown', (e) => {
		const el = (e.target as HTMLElement).closest<HTMLElement>('.note.is-mine');
		if (el && (e.key === 'Enter' || e.key === ' ')) {
			e.preventDefault();
			const note = notes.get(el.dataset.id!);
			if (note) openEditor(note.x, note.line, note);
		}
	});

	// keyboard route: start a note on the first free line at the left margin
	writeBtn?.addEventListener('click', () => {
		const used = new Set<number>();
		notes.forEach((n) => used.add(n.line));
		let line = 0;
		while (used.has(line)) line++;
		openEditor(0.08, line);
	});

	// notes wrap differently at new widths, so re-measure when the paper gets wider or narrower
	let lastWidth = 0;
	new ResizeObserver(() => {
		if (paper.clientWidth === lastWidth) return;
		lastWidth = paper.clientWidth;
		notes.forEach((n) => drawNote(n));
		fitPaper();
	}).observe(paper);

	loadNotes()
		.then((list) => {
			list.forEach((n) => {
				notes.set(n.id, n);
				drawNote(n);
			});
			fitPaper();
		})
		.catch((error) => {
			console.error(error);
			say(words.loadFailed);
			fitPaper();
		});
</script>

<style>
	/* the paper is the whole page */
	.wall-page {
		min-height: 100vh;
		min-height: 100dvh;
	}

	/* same glossy blue pill as the other buttons, pinned to the corner */
	.back {
		position: fixed;
		top: 16px;
		left: 16px;
		z-index: 5;
	}

	.back .btn-gloss {
		padding: 0.6rem 1.3rem 0.6rem 1rem;
	}

	.back svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.back .btn-gloss:focus-visible {
		outline: 3px solid var(--pink-deep);
		outline-offset: 3px;
	}

	/* plain lined paper: faint blue rules, a pink margin line, and room to keep writing */
	.paper {
		--rule: 32px;
		--top: 64px;
		position: relative;
		min-height: 100vh;
		min-height: 100dvh;
		background:
			linear-gradient(90deg, transparent calc(5% - 1px), rgba(230, 62, 125, 0.55) calc(5% - 1px), rgba(230, 62, 125, 0.55) calc(5% + 1px), transparent calc(5% + 1px)),
			repeating-linear-gradient(180deg, transparent 0, transparent calc(var(--rule) - 1px), rgba(40, 120, 200, 0.28) calc(var(--rule) - 1px), rgba(40, 120, 200, 0.28) var(--rule)) 0 var(--top) / 100% calc(100% - var(--top)) no-repeat,
			#fffdf8;
		cursor: text;
		overflow: hidden;
	}

	.hint {
		position: absolute;
		top: calc(var(--top) + var(--rule) * 1);
		left: 8%;
		margin: 0;
		line-height: var(--rule);
		color: rgba(17, 17, 17, 0.4);
		font-style: italic;
		pointer-events: none;
	}

	/* a note is plain writing on the lines */
	.paper :global(.note) {
		position: absolute;
		box-sizing: border-box;
		min-width: 9rem;
		margin: 0;
		padding: 0 0.25rem;
		font-family: var(--font-text);
		font-size: 1.05rem;
		line-height: var(--rule);
		color: var(--ink);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		cursor: default;
	}

	/* your own notes from this session: a pink ink, and they can be clicked to edit */
	.paper :global(.note.is-mine) {
		color: var(--pink-deep);
		border-radius: 4px;
		cursor: text;
	}

	.paper :global(.note.is-mine:hover),
	.paper :global(.note.is-mine:focus-visible) {
		outline: 1.5px dashed var(--pink-deep);
		outline-offset: 2px;
	}

	.paper :global(.note-draft) {
		width: 22rem;
		height: var(--rule);
		border: 0;
		border-radius: 4px;
		outline: 1.5px dashed var(--pink-deep);
		outline-offset: 2px;
		background: rgba(255, 211, 230, 0.35);
		color: var(--pink-deep);
		resize: none;
		overflow: hidden;
		caret-color: var(--pink-deep);
	}

	/* the keyboard route; tucked in the top corner of the paper */
	.write-btn {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 2;
		padding: 0.4rem 0.9rem;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		background: var(--white);
		color: var(--ink);
		font: 600 0.875rem var(--font-text);
	}

	.write-btn:hover {
		background: var(--pink-soft);
	}

	.write-btn:focus-visible {
		outline: 3px solid var(--pink-deep);
		outline-offset: 2px;
	}

	/* save messages float at the bottom of the screen */
	.status {
		position: fixed;
		bottom: 16px;
		left: 50%;
		z-index: 5;
		margin: 0;
		padding: 0.45rem 1rem;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		background: var(--white);
		font-weight: 600;
		transform: translateX(-50%);
	}

	.status:empty {
		display: none;
	}

	@media (max-width: 760px) {
		.paper :global(.note-draft) {
			width: auto;
			right: 0.5rem;
		}
	}
</style>
