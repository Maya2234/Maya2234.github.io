---
import '../styles/brand.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookBay from '../components/BookBay.astro';
import EdgeScroll from '../components/EdgeScroll.astro';
import Canvas from '../components/Canvas.astro';
import { getLang, languages, switchLang, t, type Lang } from '../i18n';

interface Props {
	current?: 'home' | 'projects' | 'wall';
	title?: string;
	// what search engines and link previews show under the title (defaults to the site's description)
	description?: string;
	// full-screen pages (the message wall): no nav, footer or guest book
	bare?: boolean;
}

const { current, title, bare = false, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url);
const site = Astro.site ?? Astro.url;
const w = t(lang);
const pageTitle = title ? `${title} | Maya Tomarchio` : w('site.title');
const pageDescription = description ?? w('site.description');
// the one official address for this page, so Google doesn't count copies (with #hashes or ?queries) separately
const canonical = new URL(Astro.url.pathname, site).href;
const ogLocale = { en: 'en_US', es: 'es_ES', it: 'it_IT' }[lang];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="192x192" href={`${base}halftone_star.png`} />
		<link rel="icon" type="image/png" sizes="512x512" href={`${base}halftone_star_512.png`} />
		<link rel="shortcut icon" type="image/png" href={`${base}halftone_star.png`} />
		<link rel="apple-touch-icon" sizes="192x192" href={`${base}halftone_star.png`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;600&family=Orbitron:wght@700&family=Unbounded:wght@900&family=Pacifico&display=swap" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonical} />
		<!-- link previews (iMessage, LinkedIn, Slack...) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Maya Tomarchio" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(`${base}me.jpg`, site).href} />
		<meta property="og:locale" content={ogLocale} />
		<meta name="twitter:card" content="summary" />
		{(Object.keys(languages) as Lang[]).map((code) => (
			<link rel="alternate" hreflang={code} href={new URL(switchLang(Astro.url, code), site).href} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(switchLang(Astro.url, 'en'), site).href} />
		<link rel="sitemap" href={`${base}sitemap-index.xml`} />
	</head>
	<body>
		{bare ? (
			<slot />
		) : current === 'home' ? (
			<div class="viewport">
				<div class="world">
					<slot name="left" />
					<div class="stage">
						<SiteNav current={current} />
						<slot />
						<SiteFooter />
					</div>
					<BookBay />
					<slot name="below" />
				</div>
			</div>
			<Canvas />
		) : (
			<>
				<SiteNav current={current} />
				<slot />
				<SiteFooter />
			</>
		)}
		{current !== 'home' && <EdgeScroll />}
	</body>
</html>

<style>
	/* Super Ramen is listed as freeware on FontSpace; confirm commercial use there before launch */
	@font-face {
		font-family: 'Super Ramen';
		src: url('../assets/fonts/SuperRamen.ttf') format('truetype');
		font-display: swap;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	/*
	  The homepage is a canvas: the projects gallery, the page and the guest book along the top, project pages below.
	  The viewport is the window onto it; src/scripts/camera.ts moves and zooms the world inside.
	*/
	:global(:root) {
		--book-shift: clamp(340px, 60vw, 720px);
	}

	/* only the camera's view shows; the page itself never scrolls */
	.viewport {
		position: fixed;
		inset: 0;
		overflow: clip;
		/* the canvas handles touch drags and pinches itself */
		touch-action: none;
	}

	/* BookBay's script moves this (transform) as the camera pans */
	.world {
		position: absolute;
		top: 0;
		left: 0;
		width: 100vw;
		display: flex;
		align-items: stretch;
		transform-origin: 0 0;
		will-change: transform;
	}

	.stage {
		flex: 0 0 100%;
		min-width: 0;
	}

</style>
