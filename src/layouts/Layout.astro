---
import '../styles/brand.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	current?: 'home' | 'projects' | 'wall';
	title?: string;
}

const { current, title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="192x192" href={`${base}halftone_star.png`} />
		<link rel="icon" type="image/png" sizes="512x512" href={`${base}halftone_star_512.png`} />
		<link rel="shortcut icon" type="image/png" href={`${base}halftone_star.png`} />
		<link rel="apple-touch-icon" sizes="192x192" href={`${base}halftone_star.png`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;600&family=Orbitron:wght@700&family=Unbounded:wght@900&display=swap" />
		<title>{title ? `${title} | Maya Tomarchio` : 'Maya Tomarchio | Developer'}</title>
	</head>
	<body>
		<SiteNav current={current} />
		<slot />
		<SiteFooter showWallLink={current !== 'wall'} />
	</body>
</html>

<style>
	/* Super Ramen is listed as freeware on FontSpace; confirm commercial use there before launch */
	@font-face {
		font-family: 'Super Ramen';
		src: url('../assets/fonts/SuperRamen.ttf') format('truetype');
		font-display: swap;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
