# Message wall (Supabase). Copy this file to .env and fill in the values from
# Supabase > Project Settings > API. The anon key is safe to expose in the browser;
# row level security in supabase/message_wall.sql limits what it can do.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Quarterly newsletter (Buttondown). Your Buttondown username, from buttondown.com > Settings.
# Leave it empty and the sign-up form says sign-ups open soon.
PUBLIC_BUTTONDOWN_USERNAME=
